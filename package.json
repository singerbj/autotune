{
  "name": "tunedup-workspace",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "bindings": "cargo test -p tunedup --lib tests::export_bindings",
    "lint": "npm run lint -w ui",
    "format": "npm run format -w ui && cargo fmt --all",
    "check": "npm run check -w ui && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm test -w ui && cargo test --workspace",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "lefthook": "^2.1.14"
  },
  "engines": {
    "node": ">=22"
  },
  "version": "0.0.1"
}
